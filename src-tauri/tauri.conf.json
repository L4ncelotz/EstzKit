{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EstzKit",
  "version": "0.1.0",
  "identifier": "dev.estzkit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "EstzKit",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
